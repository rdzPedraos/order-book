# Copy to configs/.env for local development: cp configs/.env.example configs/.env
# Values match deploy/docker-compose.yml.
APP_NAME=wallet-service
HTTP_PORT=8010
METRICS_PORT=2131
ROLE=api # api, funds or trades; run funds with HTTP_PORT=8011 METRICS_PORT=2132, trades with METRICS_PORT=2133

DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=exchange
DB_PASSWORD=exchange
DB_NAME=wallet_service
DB_SSL_MODE=disable
GOFR_TELEMETRY=false

# Event log (Redpanda in deploy/docker-compose.yml), read by the trades role.
EVENT_LOG_BROKERS=localhost:19092
EVENT_LOG_GROUP=wallet-trades
