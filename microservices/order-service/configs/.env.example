# Copy to configs/.env for local development: cp configs/.env.example configs/.env
# Values match deploy/docker-compose.yml.
APP_NAME=order-service
HTTP_PORT=8000

DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=exchange
DB_PASSWORD=exchange
DB_NAME=order_service
DB_SSL_MODE=disable
GOFR_TELEMETRY=false

ROLE=api # api or projector
COMMAND_LOG_BROKERS=localhost:19092
COMMAND_LOG_GROUP=order-service
